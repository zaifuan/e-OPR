# =========================================================
# Sistem OPR - Template Environment Variables
# Salin fail ini kepada .env dan isikan nilai sebenar:
#   cp .env.example .env
#   nano .env
#
# JANGAN commit fail .env (hanya .env.example) ke git/simpanan awam.
# =========================================================

NODE_ENV=production

# Port aplikasi pada host (127.0.0.1 sahaja - lihat docker-compose.yml).
# Tukar jika port ini bertembung dengan aplikasi lain pada server.
PORT=3070

# --- PostgreSQL ---
POSTGRES_DB=opr
POSTGRES_USER=opr_user
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUKUH

# PENTING: password dalam DATABASE_URL mesti SAMA dengan POSTGRES_PASSWORD di atas.
# Hostname "opr-postgres" ialah nama servis dalam docker-compose.yml - jangan tukar.
DATABASE_URL=postgresql://opr_user:GANTI_DENGAN_PASSWORD_KUKUH@opr-postgres:5432/opr

# --- Session Admin ---
# Rentetan rawak panjang (cth. jana dengan: openssl rand -hex 32)
SESSION_SECRET=GANTI_DENGAN_RENTETAN_RAWAK_PANJANG

# --- Storan ---
PDF_STORAGE_PATH=/app/data/pdfs
TEMP_STORAGE_PATH=/app/data/tmp

# --- Puppeteer/Chromium (Fasa 3) ---
# Dockerfile sudah menetapkan default yang betul (/usr/bin/chromium-browser,
# dipasang melalui apk). Hanya perlu ubah baris ini jika anda menukar base
# image atau lokasi Chromium tersuai.
# CHROMIUM_PATH=/usr/bin/chromium-browser

# --- Rangkaian / Cloudflare ---
# Subdomain awam sistem ini selepas Cloudflare disediakan.
APP_BASE_URL=https://opr.byzaifuan.com

# Set 1 kerana aplikasi berada di belakang Cloudflare/reverse proxy (perlu untuk
# secure cookie & pengesanan IP yang betul). Tukar ke 0 hanya jika diakses terus
# tanpa proxy di hadapannya.
TRUST_PROXY=1

# --- Google Drive Backup (opsyenal) ---
# Salinan backup PDF OPR ke Google Drive selepas local archive berjaya.
# CIRI OPSYENAL - jika mana-mana nilai di bawah kosong/tiada, backup Google
# Drive automatik disabled (log "[Google Drive] Backup disabled: configuration
# incomplete") tanpa menjejaskan penjanaan OPR tempatan.
# OAuth client jenis "Web application", scope: https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
