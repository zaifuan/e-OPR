<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4 portrait; margin: 0; }
  html, body { margin: 0; padding: 0; }
  * { box-sizing: border-box; }

  body {
    font-family: 'Liberation Sans', 'Noto Sans', Arial, sans-serif;
    color: #17181A;
  }

  /* height (bukan min-height) + overflow visible (lalai) pada .opr-page -
     lihat nota panjang dalam fail lama; teknik sama dikekalkan supaya
     overflow sebenar mencipta halaman ke-2 yang boleh dikesan pdf-lib,
     dan supaya nisbah flex-grow diselesaikan dengan betul di seluruh
     pepohon bersarang. */
  .opr-page {
    width: 210mm;
    height: 297mm;
    display: flex;
    flex-direction: row;
    --theme-primary: {{theme.primary}};
    --theme-dark: {{theme.dark}};
    --theme-light: {{theme.light}};
    --theme-accent: {{theme.accent}};
    --ink: {{neutral.ink}};
    --gray: {{neutral.gray}};
    --gray-dark: {{neutral.grayDark}};
  }

  /* ---------- Side banner dinamik (Bahagian 6) ---------- */
  .side-banner {
    flex: 0 0 20mm;
    min-height: 0;
    position: relative;
    background: var(--theme-primary);
    clip-path: polygon(0 0, 100% 3.5%, 100% 96.5%, 0 100%);
    overflow: hidden;
  }
  .side-banner-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-90deg);
    white-space: nowrap;
    font-size: 25pt;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #ffffff;
  }

  /* ---------- Bungkusan kandungan ---------- */
  .content-shell {
    flex: 1 1 auto;
    min-height: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: visible;
  }

  /* ---------- Geometri hiasan (Bahagian 8) - di belakang kandungan ---------- */
  .geo-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 32mm;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .geo-top .g-a {
    position: absolute; top: 0; right: 0; width: 68%; height: 100%;
    background: var(--theme-primary);
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }
  .geo-top .g-b {
    position: absolute; top: 0; right: 0; width: 46%; height: 100%;
    background: var(--ink);
    clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%);
  }
  .geo-top .g-c {
    position: absolute; top: 0; right: 4%; width: 24%; height: 62%;
    background: var(--gray);
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }

  /* Jalur geometri bawah - SENGAJA sebahagian aliran flex biasa (bukan
     absolute overlay) supaya ia MUSTAHIL bertindih kandungan info-column
     tidak kira berapa panjang teks (Nama Program/Penglibatan/Rumusan boleh
     berbeza tinggi ikut kandungan sebenar guru) - lebih teguh berbanding
     cuba kira "bottom: Xmm" tetap yang boleh silap anggaran. */
  .geo-bottom-strip {
    position: relative;
    flex: 0 0 auto;
    height: 6mm;
    margin-top: 1.5mm;
    overflow: hidden;
    pointer-events: none;
  }
  .geo-bottom-strip .g-a {
    position: absolute; inset: 0; left: 0; width: 58%;
    background: var(--theme-primary);
    clip-path: polygon(0 32%, 100% 0, 100% 100%, 0 100%);
  }
  .geo-bottom-strip .g-b {
    position: absolute; top: 0; bottom: 0; left: 0; width: 34%;
    background: var(--ink);
    clip-path: polygon(0 55%, 100% 0, 100% 100%, 0 100%);
  }

  /* Watermark dipindah ke dalam .info-column - lihat definisi berhampiran
     .info-column di bawah (Bahagian 3/4/18 - watermark mesti centered
     terhadap CONTENT COLUMN, bukan keseluruhan content-shell/A4). */

  /* ---------- Header (Bahagian 5) ---------- */
  .header {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    padding: 6mm 9mm 0 9mm;
  }
  .header-top {
    display: flex;
    align-items: center;
    gap: 4.5mm;
    margin-bottom: 2.2mm;
  }
  .header-logo {
    flex: 0 0 auto;
    width: 22mm;
    height: 22mm;
    background: #fff;
    border-radius: 2mm;
    padding: 1.5mm;
    box-shadow: 0 0.6mm 2mm rgba(0, 0, 0, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .header-logo svg { width: 100%; height: 100%; display: block; }
  .header-title-group {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    min-width: 0;
  }
  .title-onepage {
    font-size: 25pt;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .title-report {
    font-size: 30pt;
    font-style: italic;
    font-weight: 700;
    color: #FFFFFF; /* Pembaharuan 05: putih solid untuk semua tema (sebelum ini var(--theme-accent)) */
    margin-left: 2.5mm;
  }
  .header-schoolbar {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    font-size: 12.5pt;
    font-weight: 800;
    letter-spacing: 0.035em;
    padding: 2.2mm 5mm;
  }
  .header-schoolbar .code {
    font-weight: 400;
    opacity: 0.8;
    font-size: 0.72em;
  }

  /* ---------- Badan utama (Bahagian 12/14) ---------- */
  .report-body {
    position: relative;
    z-index: 2;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: row;
    gap: 6mm;
    padding: 4mm 9mm 0 9mm;
  }

  .info-column { position: relative; flex: 64 1 0; min-height: 0; display: flex; flex-direction: column; }

  /* Watermark logo rasmi (Bahagian 3/4/5/6/7 - polish v2.2): dipusatkan
     secara horizontal terhadap .info-column SAHAJA (bukan content-shell
     penuh yang turut merangkumi lajur gambar) - left:50%+translateX(-50%)
     berbanding lebar SEBENAR info-column tidak kira nisbah flex/padding
     tepat, jadi kekal betul walau proportion diselaraskan kelak.
     z-index:-1 (bukan 0) supaya kekal di BELAKANG kandungan statik
     info-column - disahkan empirik z-index:0 tidak mencukupi di sini
     kerana .report-body sendiri sudah stacking context (z-index:2). */
  .body-watermark {
    position: absolute;
    left: 50%;
    bottom: 27mm;
    transform: translateX(-50%);
    width: 100mm; height: 100mm;
    opacity: 0.08;
    filter: grayscale(1);
    z-index: -1;
    pointer-events: none;
  }
  .body-watermark svg { width: 100%; height: 100%; display: block; }

  .field-block { flex: 0 0 auto; margin-bottom: 1.8mm; }

  .field-label {
    font-size: 9.5pt;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--theme-primary);
    margin-bottom: 0.7mm;
  }
  .field-value {
    font-size: 10.5pt;
    line-height: 1.22;
    color: var(--ink);
    word-break: break-word;
    white-space: pre-wrap;
  }
  .field-value.name { font-size: 14pt; font-weight: 700; line-height: 1.18; }
  .field-value.body { font-size: 9.6pt; line-height: 1.24; }
  /* Pembaharuan 03: tajuk maklumat tambahan (teks guru) - balut jika
     terlalu lebar supaya tidak melimpah ke lajur gambar. */
  .field-label.extra-title { overflow-wrap: anywhere; }
  /* Pembaharuan 04: Jawatan di bawah nama tandatangan - sedikit lebih kecil
     daripada nama (10.5pt), warna & fon sama. Tiada elemen jika kosong. */
  .field-value.signatory-position { font-size: 9.5pt; line-height: 1.2; margin-top: 0.6mm; overflow-wrap: anywhere; }

  .field-row { display: flex; gap: 7mm; flex: 0 0 auto; margin-bottom: 1.8mm; }

  /* Anchor tandatangan ke bahagian BAWAH info-column (Bahagian 9/10/11/45
     polish v2.2). margin-top:auto ialah teknik flexbox piawai "tolak ke
     hujung bekas" - ia HANYA menambah ruang kosong SEBELUM baris ini,
     tidak pernah menghadkan/memotong Rumusan atau mana-mana kandungan
     pengguna (elak sepenuhnya corak bug v2.1 yang letak max-height pada
     kotak berisi teks). Kandungan pendek -> ruang kosong besar, tandatangan
     jatuh ke bawah sekali. Kandungan panjang/ekstrem -> ruang auto mengecil
     ke arah 0 (margin auto tidak boleh negatif), tandatangan kekal tepat
     selepas Rumusan tanpa bertindih. */
  .info-column > .field-row:last-child { margin-top: auto; padding-top: 4mm; }
  .field-row .field-block { flex: 1; margin-bottom: 0; }

  /* Pembaharuan 02: jadual kecil Tarikh & Masa (masa berbeza, maks 5 baris).
     Saiz font sama seperti .field-value.body; warna ikut tema anjuran. */
  .schedule-table {
    border-collapse: collapse;
    font-size: 9.6pt;
    line-height: 1.2;
    color: var(--ink);
  }
  .schedule-table th {
    text-align: left;
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--theme-dark);
    background: var(--theme-light);
    padding: 0.8mm 3mm;
  }
  .schedule-table td {
    padding: 0.7mm 3mm;
    border-bottom: 0.25mm solid var(--gray);
    white-space: nowrap;
  }
  .schedule-table th:first-child,
  .schedule-table td:first-child { padding-left: 1.5mm; padding-right: 6mm; }

  /* --- Lajur gambar (Bahagian 14/17) --- */
  .photo-column { flex: 36 1 0; min-height: 0; display: flex; flex-direction: column; gap: 3mm; }

  .photo-frame {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    background: #fff;
    padding: 2mm;
    box-shadow: 0 0.7mm 2.5mm rgba(23, 24, 26, 0.25);
  }
  .photo-frame-inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }
  .photo-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(6px) brightness(0.6);
    transform: scale(1.15);
  }
  .photo-fg {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    display: block;
  }

  /* ---------- Footer (Bahagian 18) ---------- */
  /* Pilihan B daripada ujian A/B (logo dibesarkan vs tanpa logo) - slogan
     kekal fokus tunggal footer; logo rasmi sudah sangat jelas di header
     dan watermark, jadi mengulanginya di sini hanya menambah persaingan
     visual tanpa nilai tambah. */
  .footer {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    background: var(--ink);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5mm 9mm;
  }
  /* ---------- Pembaharuan 05: watermark SAJ.A ----------
     Diletak dalam ruang putih segi tiga di hujung bawah banner kiri (hasil
     clip-path .side-banner: bucu (20mm, 286.6mm), (20mm, 297mm), (0, 297mm)).
     Kedudukan mutlak terhadap halaman (bukan sebahagian aliran layout) -
     tiada elemen lain berganjak. Diputar -27.5deg supaya selari dengan sisi
     serong banner. Warna = neutral grayDark template (#8D908B).
     Pembetulan: diletak sejauh mungkin ke dalam bucu atas segi tiga (jarak
     kotak 0.6mm dari sisi serong & jalur footer) untuk menjauhi tepi bawah
     halaman (~2.4mm). 5mm tidak boleh dicapai: pada y <= 292mm segi tiga
     putih hanya 10.4 x 5.4mm dan memuatkan kotak selari maks ~5.2mm lebar,
     sedangkan teks memerlukan 8.73mm. */
  .saja-mark {
    position: absolute;
    left: 14.92mm;
    top: 291.42mm;
    transform: translate(-50%, -50%) rotate(-27.46deg);
    font-size: 7.5pt;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
    color: var(--gray-dark);
    pointer-events: none;
  }
  .footer-slogan { font-size: 11.5pt; font-weight: 800; letter-spacing: 0.16em; }
</style>
</head>
<body>
  <div class="opr-page">
    <div class="saja-mark">SAJ.A</div>
    <div class="side-banner">
      <div class="side-banner-text">{{organizer}}</div>
    </div>

    <div class="content-shell">
      <div class="geo-top">
        <div class="g-a"></div>
        <div class="g-b"></div>
        <div class="g-c"></div>
      </div>

      <header class="header">
        <div class="header-top">
          <div class="header-logo">{{{logoSvg}}}</div>
          <div class="header-title-group">
            <span class="title-onepage">ONE PAGE</span><span class="title-report">Report</span>
          </div>
        </div>
        <div class="header-schoolbar">{{schoolName}} <span class="code">({{schoolCode}})</span></div>
      </header>

      <div class="report-body">
        <div class="info-column">
          <div class="body-watermark">{{{logoSvg}}}</div>

          <div class="field-block">
            <div class="field-label">Nama Program</div>
            <div class="field-value name">{{programName}}</div>
          </div>

          {{#if scheduleRows}}
          <!-- Pembaharuan 02: Tarikh Berasingan + Masa Berbeza (2-5 sesi) -->
          <div class="field-block">
            <div class="field-label">Tarikh &amp; Masa</div>
            <table class="schedule-table">
              <thead><tr><th>Tarikh</th><th>Masa</th></tr></thead>
              <tbody>
                {{#each scheduleRows}}
                <tr><td>{{date}}</td><td>{{time}}</td></tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          {{else}}
          <div class="field-row">
            <div class="field-block">
              <div class="field-label">Tarikh</div>
              <div class="field-value">{{dateInfo.line1}}{{#if dateInfo.line2}}<br>{{dateInfo.line2}}{{/if}}</div>
            </div>
            <div class="field-block">
              <div class="field-label">Masa</div>
              <div class="field-value">{{timeFormatted}}</div>
            </div>
          </div>
          {{/if}}

          <div class="field-row">
            <div class="field-block">
              <div class="field-label">Tempat</div>
              <div class="field-value">{{location}}</div>
            </div>
            <div class="field-block">
              <div class="field-label">Kumpulan Sasaran/<wbr>Penglibatan</div>
              <div class="field-value">{{targetGroup}}</div>
            </div>
          </div>

          {{#if objectives}}
          <div class="field-block">
            <div class="field-label">Objektif / Matlamat</div>
            <div class="field-value body">{{objectives}}</div>
          </div>
          {{/if}}

          {{#if activitySummary}}
          <div class="field-block">
            <div class="field-label">Ringkasan Aktiviti</div>
            <div class="field-value body">{{activitySummary}}</div>
          </div>
          {{/if}}

          {{#if strengths}}
          <div class="field-block">
            <div class="field-label">Kekuatan</div>
            <div class="field-value body">{{strengths}}</div>
          </div>
          {{/if}}

          {{#if weaknesses}}
          <div class="field-block">
            <div class="field-label">Kelemahan</div>
            <div class="field-value body">{{weaknesses}}</div>
          </div>
          {{/if}}

          {{#if improvements}}
          <div class="field-block">
            <div class="field-label">Penambahbaikan</div>
            <div class="field-value body">{{improvements}}</div>
          </div>
          {{/if}}

          {{!-- Pembaharuan 03: LAIN-LAIN (NYATAKAN) - setiap set ialah seksyen
               laporan biasa (tajuk guru sebagai label). Tajuk induk tidak
               dipaparkan. {{ }} meng-escape HTML; pre-wrap kekalkan baris baru. --}}
          {{#each additionalInfo}}
          <div class="field-block">
            <div class="field-label extra-title">{{title}}</div>
            <div class="field-value body">{{content}}</div>
          </div>
          {{/each}}

          <div class="field-row">
            <div class="field-block">
              <div class="field-label">Disediakan Oleh</div>
              <div class="field-value">{{preparedBy}}</div>
              {{#if preparedByPosition}}<div class="field-value signatory-position">{{preparedByPosition}}</div>{{/if}}
            </div>
            <div class="field-block">
              <div class="field-label">Disahkan Oleh</div>
              <div class="field-value">{{verifiedBy}}</div>
              {{#if verifiedByPosition}}<div class="field-value signatory-position">{{verifiedByPosition}}</div>{{/if}}
            </div>
          </div>
        </div>

        <div class="photo-column">
          {{{imageGridHtml}}}
        </div>
      </div>

      <div class="geo-bottom-strip">
        <div class="g-a"></div>
        <div class="g-b"></div>
      </div>

      <div class="footer">
        <span class="footer-slogan">{{slogan}}</span>
      </div>
    </div>
  </div>
  <!-- Pembaharuan 01: muatkan teks banner menegak (nama anjuran manual
       LAIN-LAIN boleh mencecah 100 aksara). Skrip HANYA bertindak jika teks
       melebihi ruang banner - 3 anjuran asal (muat pada 25pt) tidak disentuh
       langsung, jadi rupa PDF asal kekal sama. Langkah 1: kecilkan saiz font
       satu baris (25pt -> 14pt). Langkah 2: jika masih panjang, benarkan
       2 baris dan kecilkan lagi sehingga muat. Banner overflow:hidden, jadi
       teks panjang tidak sekali-kali menolak kandungan ke halaman kedua. -->
  <script>
    (function () {
      var banner = document.querySelector('.side-banner');
      var text = banner && banner.querySelector('.side-banner-text');
      if (!banner || !text) return;
      var MM = 96 / 25.4;
      // Panjang selamat = ketinggian banner tolak hujung serong clip-path
      // (3.5% setiap hujung) dan margin 6mm; tebal selamat = lebar banner - 4mm.
      var maxLen = banner.clientHeight * 0.93 - 12 * MM;
      var maxThick = banner.clientWidth - 4 * MM;
      function fits() {
        return text.scrollWidth <= maxLen && text.offsetHeight <= maxThick;
      }
      if (fits()) return;
      var size = 25;
      while (!fits() && size > 14) {
        size -= 0.5;
        text.style.fontSize = size + 'pt';
      }
      if (fits()) return;
      text.style.whiteSpace = 'normal';
      text.style.width = maxLen + 'px';
      text.style.textAlign = 'center';
      text.style.lineHeight = '1.1';
      text.style.overflowWrap = 'anywhere';
      while (!fits() && size > 6) {
        size -= 0.5;
        text.style.fontSize = size + 'pt';
      }
    })();
  </script>
  <!-- Pembaharuan 04: pengawal limpahan lajur maklumat. Semakan halaman
       (pdf-lib) hanya mengesan halaman ke-2; kandungan yang melimpah keluar
       lajur maklumat tetapi masih dalam halaman A4 akan BERTINDIH dengan
       jalur bawah/footer tanpa dikesan. Jika blok terakhir (tandatangan)
       melepasi sempadan bawah lajur, tambah satu pemisah halaman kosong ->
       PDF menjadi 2 halaman -> ditolak oleh mekanisme 422 sedia ada (tiada
       muat naik, tiada rekod). Tiada kesan langsung jika kandungan muat. -->
  <script>
    (function () {
      var col = document.querySelector('.info-column');
      var last = col && col.lastElementChild;
      if (!col || !last) return;
      if (last.getBoundingClientRect().bottom > col.getBoundingClientRect().bottom + 0.5) {
        var guard = document.createElement('div');
        guard.style.cssText = 'break-before: page; page-break-before: always; height: 1px;';
        document.body.appendChild(guard);
      }
    })();
  </script>
</body>
</html>
